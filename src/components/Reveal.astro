---
/**
 * Reveal.astro — scroll-driven reveal con IntersectionObserver.
 * Uso: <Reveal delay={100}><div>...</div></Reveal>
 */
interface Props {
  delay?: number;
  as?: string;
  class?: string;
}

const { delay = 0, as = 'div', class: className = '' } = Astro.props;
const Tag = as as keyof HTMLElementTagNameMap;
---

<Tag class={`reveal ${className}`} style={`--reveal-delay: ${delay}ms`}>
  <slot />
</Tag>

<script>
  const els = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );
    els.forEach((el) => io.observe(el));
  } else {
    els.forEach((el) => el.classList.add('is-visible'));
  }
</script>
