---
/**
 * BentoCard.astro — celda de proyecto con hover glow y arrow.
 */
import Reveal from './Reveal.astro';

interface Props {
  title: string;
  url: string;
  repo?: string;
  tech?: string;
  description: string;
  className?: string;
  featured?: boolean;
}

const { title, url, repo, tech, description, className = '', featured = false } = Astro.props;
---

<Reveal class={className}>
  <a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    class={`card-glow group flex flex-col justify-between h-full ${featured ? 'min-h-[240px]' : ''}`}
  >
    <div>
      <div class="flex items-start justify-between gap-4 mb-4">
        <span class={`font-mono text-[11px] uppercase tracking-[0.2em] ${featured ? 'text-[#22d3ee]' : 'text-[#71717a]'}`}>
          {repo ? repo.split('/')[1] : 'SWAL'}
        </span>
        <svg class="w-5 h-5 text-[#52525b] group-hover:text-[#22d3ee] transition-all duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H8m9 0v9"/>
        </svg>
      </div>
      <h3 class="font-display text-xl font-semibold text-[#f4f4f5] mb-2 group-hover:text-[#22d3ee] transition-colors duration-200">
        {title}
      </h3>
      <p class="text-[#a1a1aa] text-sm leading-relaxed">{description}</p>
    </div>
    {tech && (
      <div class="mt-5 flex flex-wrap gap-2">
        {tech.split(', ').map((t) => (
          <span class="font-mono text-[11px] px-2 py-0.5 rounded border border-white/[0.08] bg-[#161618] text-[#71717a]">
            {t}
          </span>
        ))}
      </div>
    )}
  </a>
</Reveal>
