---
import Layout from '../layouts/Layout.astro';
import ShaderBackground from '../components/ShaderBackground.astro';
import Reveal from '../components/Reveal.astro';
import '../styles/global.css';

const projects = [
  {
    id: "PRJ_01",
    title: "SaberParaTodos",
    url: "https://saberparatodos.space",
    tag: "Educational platform · 16+ countries",
    tech: "Astro, Svelte 5, TailwindCSS",
    desc: "Exámenes de práctica gratuitos y accesibles para 16+ países, con evaluaciones de IA local.",
  },
  {
    id: "PRJ_02",
    title: "Shelf",
    url: "https://estante-inventario.vercel.app",
    tag: "P2P inventory & POS",
    tech: "React 19, TypeScript, Yjs (CRDT)",
    desc: "Inventario y POS offline-first con sincronización peer-to-peer. Vende sin depender de la nube.",
  },
  {
    id: "PRJ_03",
    title: "OrionHealth",
    url: "https://github.com/iberi22/OrionHealth",
    tag: "Medical diagnostic copilot",
    tech: "Flutter, Dart, SQLite",
    desc: "Asistente de salud privacy-first con SSI on-device y estándares médicos offline.",
  },
  {
    id: "PRJ_04",
    title: "Veedur-IA",
    url: "https://github.com/iberi22/VeedurIA",
    tag: "Civic oversight & SECOP II",
    tech: "Rust, Polars, Astro, Svelte 5",
    desc: "Plataforma de inteligencia en contratación pública con análisis de licitaciones y detección de anomalías.",
  },
  {
    id: "PRJ_05",
    title: "GARA-G",
    url: "https://github.com/iberi22/gara-g",
    tag: "DePIN Mobility & V2V Mesh",
    tech: "Rust, Flutter, P2P, Polygon",
    desc: "Red DePIN de movilidad y malla vehicular V2V con telemetría en tiempo real, copiloto de IA y mercado descentralizado.",
  },
  {
    id: "PRJ_06",
    title: "SismoCheck",
    url: "https://sismocheck-evaluaci-n-r-pida-post-sismo-dossier-a-138396941132.us-east1.run.app/",
    tag: "Structural triage · ATC-20",
    tech: "React 19, WebGPU, IA on-device",
    desc: "Triage estructural post-terremoto con criterios forenses ATC-20 e IA en el dispositivo.",
  },
];

const openSource = [
  { name: "GitCore", desc: "Harness operacional y orquestador Git/GitHub", url: "https://github.com/iberi22/GitCore", accent: true },
  { name: "Xavier", desc: "Memoria cognitiva para agentes IA", url: "https://github.com/iberi22/xavier", accent: false },
  { name: "Gestalt", desc: "Orquestador multi-agente (Rust)", url: "https://github.com/iberi22/gestalt", accent: false },
  { name: "edge-mesh", desc: "Redes mesh P2P + CRDT", url: "https://github.com/iberi22/edge-mesh", accent: false },
  { name: "swal-ui", desc: "Design system Svelte 5", url: "https://github.com/iberi22/swal-ui", accent: false },
  { name: "Isar Agent Memory", desc: "Memoria semántica Flutter/Dart", url: "https://github.com/iberi22/isar_agent_memory", accent: false },
  { name: "swal-local", desc: "Librería TS zero-dep local-first", url: "https://github.com/iberi22/swal-local", accent: false },
  { name: "Skills", desc: "Registro canónico de skills para agentes", url: "https://github.com/iberi22/skills", accent: false },
];

const stack = ["Rust", "TypeScript", "Dart/Flutter", "Astro", "Python", "React", "Svelte 5", "PostgreSQL", "Supabase", "Agent Orchestration", "PWA / offline-first", "NixOS"];
---

<Layout>
  <ShaderBackground />

  <!-- ============ HERO ============ -->
  <section class="min-h-[80vh] flex flex-col justify-center max-w-4xl pt-20 mb-32">
    <Reveal>
      <div class="font-mono-label text-mono-label text-[#22d3ee] mb-6 flex items-center gap-2">
        <span class="material-symbols-outlined text-sm">terminal</span>
        <span>DEV.SYS // v1.0.0</span>
      </div>
    </Reveal>
    <Reveal delay={80}>
      <h1 class="massive-heading mb-8">
        Brahyan<br />Belalcazar
      </h1>
    </Reveal>
    <Reveal delay={160}>
      <p class="font-body-lg text-body-lg text-[#7e8b8f] max-w-2xl leading-relaxed border-l-2 border-[#3c494c]/50 pl-6">
        Full-stack &amp; systems software engineer — <span class="text-[#22d3ee]">disponible para trabajar</span>.
        Diseño y construyo sistemas en producción mediante pipelines deterministas orquestados por IA:
        arquitecturas distribuidas, tolerancia a fallos, validación formal y suites de pruebas automatizadas.
      </p>
    </Reveal>
    <Reveal delay={240}>
      <div class="mt-12 flex flex-wrap gap-4">
        <a
          href="https://portfolio-iberi22.vercel.app/agenda"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-[#22d3ee] text-[#0a0a0b] px-8 py-3 font-mono-label text-mono-label hover:bg-[#67e8f9] transition-colors flex items-center gap-2 rounded"
        >
          <span class="material-symbols-outlined text-[18px]">event_available</span>
          Agendar sesión técnica
        </a>
        <a
          href="https://github.com/iberi22"
          target="_blank"
          rel="noopener noreferrer"
          class="border border-[#3c494c]/30 text-[#cfccc7] px-8 py-3 font-mono-label text-mono-label hover:bg-[#131314] transition-colors flex items-center gap-2 rounded"
        >
          <span class="material-symbols-outlined text-[18px]">code</span>
          GitHub
        </a>
        <a
          href="https://www.linkedin.com/in/brahyansbr"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#22d3ee] px-8 py-3 font-mono-label text-mono-label hover:underline decoration-[#22d3ee] transition-all flex items-center gap-2"
        >
          LinkedIn
          <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </a>
      </div>
    </Reveal>
    <Reveal delay={320}>
      <div class="mt-14 flex flex-wrap gap-2 max-w-2xl">
        {stack.map((t) => (
          <span class="font-mono-code text-mono-code text-[12px] px-3 py-1 rounded border border-[#3c494c]/30 bg-[#131314] text-[#a8a5a1]">{t}</span>
        ))}
      </div>
    </Reveal>
  </section>

  <!-- ============ PROJECTS ============ -->
  <section class="mb-40" id="projects">
    <Reveal>
      <div class="section-head">
        <span class="material-symbols-outlined text-[#22d3ee]">apps</span>
        <h2 class="font-headline-lg text-headline-lg text-[#d8d5d0]">Proyectos</h2>
      </div>
    </Reveal>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((p, i) => (
        <Reveal delay={i * 100}>
          <a
            href={p.url}
            target="_blank"
            rel="noopener noreferrer"
            class="glass-panel p-6 flex flex-col justify-between h-56 card-hover rounded block"
          >
            <div>
              <div class="font-mono-label text-mono-label text-[#22d3ee] mb-2">{p.id}</div>
              <h4 class="font-headline-md text-headline-md text-[#cfccc7] mb-2">{p.title}</h4>
              <div class="font-mono-code text-mono-code text-[#3c494c] text-sm mb-3">{p.tag}</div>
              <p class="font-body-md text-body-md text-[#7e8b8f] leading-relaxed">{p.desc}</p>
            </div>
            <div class="flex flex-wrap gap-2 mt-4">
              {p.tech.split(", ").map((t) => (
                <span class="font-mono-code text-mono-code text-[11px] px-2 py-0.5 rounded border border-[#3c494c]/30 bg-[#0a0a0b] text-[#7e8b8f]">
                  {t}
                </span>
              ))}
            </div>
          </a>
        </Reveal>
      ))}
    </div>
  </section>

  <!-- ============ OPEN SOURCE ============ -->
  <section class="mb-40" id="stack">
    <Reveal>
      <div class="section-head">
        <span class="material-symbols-outlined text-[#22d3ee]">code_blocks</span>
        <h2 class="font-headline-lg text-headline-lg text-[#d8d5d0]">Open Source</h2>
      </div>
    </Reveal>

    <Reveal delay={100}>
      <div class="border border-[#3c494c]/20 bg-[#131314] p-8 rounded">
        <p class="font-mono-code text-mono-code text-[#7e8b8f] mb-8 leading-relaxed">
          Infraestructura de agentes, memoria cognitiva y protocolos distribuidos:
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {openSource.map((s) => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`p-4 rounded border transition-all block ${
                s.accent
                  ? "border-[#22d3ee]/40 bg-[#22d3ee]/5 hover:border-[#22d3ee]"
                  : "border-[#3c494c]/30 bg-[#0a0a0b] hover:border-[#3c494c]/60"
              }`}
            >
              <div class="flex items-center justify-between mb-1">
                <span class={`font-mono-code text-mono-code font-bold ${s.accent ? "text-[#22d3ee]" : "text-[#cfccc7]"}`}>
                  {s.name}
                </span>
                <span class="material-symbols-outlined text-xs text-[#7e8b8f]">open_in_new</span>
              </div>
              <p class="font-body-md text-body-md text-[#7e8b8f] text-xs leading-relaxed">{s.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </Reveal>
  </section>

  <!-- ============ ABOUT ============ -->
  <section class="mb-32" id="about">
    <Reveal>
      <div class="section-head">
        <span class="material-symbols-outlined text-[#22d3ee]">person</span>
        <h2 class="font-headline-lg text-headline-lg text-[#d8d5d0]">Sobre mí</h2>
      </div>
    </Reveal>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {[
        {
          icon: "bolt",
          title: "Orquestación Multi-Agente",
          text: "Enjambres de agentes autónomos ejecutan micro-tareas paralelas en ramas Git aisladas, coordinados por harnesses deterministas (Hermes/GitCore) con sandboxing VFS.",
        },
        {
          icon: "verified",
          title: "Validación Determinista",
          text: "Cada incremento pasa por compilación estricta, linters, tests unitarios y suites E2E headless. 1 Issue → 1 Rama → 1 PR. Criterios de aceptación verificables.",
        },
        {
          icon: "hub",
          title: "Arquitectura Modular & Local-First",
          text: "Protocolos P2P con sincronización CRDT, memoria cognitiva vectorial (Xavier), tokens de diseño compartidos y librerías zero-dependency para minimizar deuda técnica.",
        },
      ].map((p, i) => (
        <Reveal delay={i * 100}>
          <div class="p-8 border border-[#3c494c]/20 bg-[#131314] card-hover rounded">
            <div class="w-12 h-12 bg-[#0a0a0b] flex items-center justify-center border border-[#3c494c]/30 mb-6 rounded">
              <span class="material-symbols-outlined text-[#cfccc7]">{p.icon}</span>
            </div>
            <h3 class="font-headline-md text-headline-md text-[#d8d5d0] mb-4">{p.title}</h3>
            <p class="font-body-md text-body-md text-[#7e8b8f]">{p.text}</p>
          </div>
        </Reveal>
      ))}
    </div>

    <Reveal delay={150}>
      <div class="mt-16 max-w-3xl mx-auto text-center border border-[#3c494c]/20 bg-[#131314] rounded p-10">
        <span class="material-symbols-outlined text-[#22d3ee] text-3xl mb-4">handshake</span>
        <p class="font-headline-md text-headline-md text-[#d8d5d0] leading-snug mb-4">
          ¿Buscas optimizar tu arquitectura o integrar pipelines autónomos de ingeniería?
        </p>
        <p class="font-body-md text-body-md text-[#7e8b8f] mb-8">
          Auditoría de arquitectura técnica e infraestructura agéntica: análisis de repositorios,
          pipelines CI/CD, sincronización local-first e integración de agentes de código deterministas.
        </p>
        <a
          href="https://portfolio-iberi22.vercel.app/agenda"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-[#22d3ee] text-[#0a0a0b] px-8 py-3 font-mono-label text-mono-label hover:bg-[#67e8f9] transition-colors rounded"
        >
          Agendar sesión técnica →
        </a>
      </div>
    </Reveal>
  </section>
</Layout>
