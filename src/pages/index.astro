---
import Layout from '../layouts/Layout.astro';
import Reveal from '../components/Reveal.astro';
import Marquee from '../components/Marquee.astro';
import NeuralBackground from '../components/NeuralBackground.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BentoCard from '../components/BentoCard.astro';
import Stat from '../components/Stat.astro';
import '../styles/global.css';

const featuredProjects = [
  {
    title: "SaberParaTodos",
    repo: "iberi22/worldexams",
    url: "https://saberparatodos.space",
    tech: "Astro, Svelte, TailwindCSS, Supabase",
    description: "Exámenes de práctica para 16+ países. Educación gratuita y accesible para todos.",
    featured: true,
  },
  {
    title: "Shelf",
    repo: "iberi22/shelf",
    url: "https://shelf-inventory.vercel.app",
    tech: "React 19, TypeScript, P2P (CRDT)",
    description: "Inventario + POS offline-first con sincronización P2P y cifrado post-quantum.",
    featured: true,
  },
  {
    title: "Hosteler-IA",
    repo: "iberi22/hosteler-ia",
    url: "https://hosteler-ia-mu.vercel.app",
    tech: "TypeScript, React, IA",
    description: "Gestión de servicios de campo (FSM) con IA, aprobaciones digitales y modo offline.",
    featured: true,
  },
  {
    title: "MiMatera",
    repo: "iberi22/portafolio-mimatera",
    url: "https://mimatera-catalogador.pages.dev",
    tech: "PWA, JavaScript",
    description: "Catálogo PWA de materas con fotos y tokens de un solo uso.",
  },
  {
    title: "TikTokBoost",
    repo: "iberi22/tiktboost",
    url: "https://tiktboost.vercel.app",
    tech: "TypeScript",
    description: "Gestor de contenido y métricas TikTok.",
  },
  {
    title: "OrionHealth",
    repo: "iberi22/OrionHealth",
    url: "https://github.com/iberi22/OrionHealth",
    tech: "Flutter, Dart",
    description: "Asistente de salud privacy-first con SSI on-device y estándares médicos offline.",
  },
];

const openSourceProjects = [
  { title: "Gestalt", repo: "iberi22/gestalt" },
  { title: "Xavier", repo: "iberi22/xavier" },
  { title: "Obscura", repo: "iberi22/obscura" },
  { title: "swal-ui", repo: "iberi22/swal-ui" },
  { title: "SWAL Desktop", repo: "iberi22/swal-desktop" },
  { title: "GOS", repo: "iberi22/gastronomic-open-standard-GOS" },
  { title: "Isar Agent Memory", repo: "iberi22/isar_agent_memory" },
  { title: "Skills", repo: "iberi22/skills" },
  { title: "MCP Database Server", repo: "iberi22/mcp-database-server" },
  { title: "Socrata-rs", repo: "iberi22/socrata-rs" },
  { title: "SWAL Agent Rust", repo: "iberi22/swal-agent-rust" },
  { title: "WebAuditMCP", repo: "iberi22/WebAuditMCP" },
];

const stack = ["Rust", "TypeScript", "Astro", "Python", "Flutter", "React", "PostgreSQL", "Supabase", "P2P", "WebAssembly", "Svelte", "TailwindCSS"];
---

<Layout>
  <!-- ============ HERO ============ -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <NeuralBackground />

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center pt-24 pb-20">
      <Reveal>
        <div class="inline-flex items-center gap-3 px-4 py-2 rounded-full border border-white/[0.08] bg-[#111113] mb-10">
          <span class="live-dot"></span>
          <span class="font-mono text-xs text-[#a1a1aa] tracking-wide">Open Source First</span>
        </div>
      </Reveal>

      <Reveal delay={100}>
        <h1 class="font-display text-6xl sm:text-7xl md:text-8xl font-bold text-[#f4f4f5] mb-8 tracking-tight leading-[1.02]">
          SouthWest<br />
          <span class="text-[#22d3ee]">AI Labs</span>
        </h1>
      </Reveal>

      <Reveal delay={200}>
        <p class="text-lg sm:text-xl text-[#a1a1aa] max-w-2xl mx-auto mb-12 leading-relaxed">
          Building <span class="text-[#f4f4f5] font-medium">local-first, privacy-first AI</span>: agents with infinite memory
          that live on <span class="text-[#f4f4f5] font-medium">your device</span> — not in someone else's data center.
        </p>
      </Reveal>

      <Reveal delay={300}>
        <div class="flex flex-wrap items-center justify-center gap-4 mb-12">
          <a href="#projects" class="btn-primary">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
            Ver Proyectos
          </a>
          <a href="#research" class="btn-secondary">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
            </svg>
            Research
          </a>
        </div>
      </Reveal>

      <Reveal delay={400}>
        <div class="flex flex-wrap items-center justify-center gap-3">
          {["🏠 Local-first", "🔐 Privacy-first", "🕊️ Open source", "🤖 Agentic"].map((t) => (
            <span class="px-4 py-1.5 rounded-full border border-white/[0.08] bg-[#111113] text-[#a1a1aa] font-mono text-xs">
              {t}
            </span>
          ))}
        </div>
      </Reveal>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-[#52525b]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
      </svg>
    </div>
  </section>

  <!-- ============ MARQUEE ============ -->
  <Marquee items={stack} />

  <!-- ============ FEATURED PROJECTS ============ -->
  <section id="projects" class="py-24 px-4 sm:px-6 lg:px-8 scroll-mt-16">
    <div class="max-w-7xl mx-auto">
      <SectionHeading
        index="001"
        title="Featured Projects"
        subtitle="Aplicaciones reales, en producción, construidas con la infraestructura del laboratorio."
      />

      <div class="bento-grid">
        <BentoCard {...featuredProjects[0]} className="bento-lg" featured />
        <BentoCard {...featuredProjects[1]} className="bento-sm" />
        <BentoCard {...featuredProjects[2]} className="bento-sm" />
        <BentoCard {...featuredProjects[3]} className="bento-2" />
        <BentoCard {...featuredProjects[4]} className="bento-2" />
        <BentoCard {...featuredProjects[5]} className="bento-lg" featured />
      </div>
    </div>
  </section>

  <!-- ============ OPEN SOURCE ============ -->
  <section id="open-source" class="py-24 px-4 sm:px-6 lg:px-8 bg-[#0c0c0e] border-y border-white/[0.06] scroll-mt-16">
    <div class="max-w-7xl mx-auto">
      <SectionHeading
        index="002"
        title="Open Source"
        subtitle="Protocolos, herramientas y librerías del laboratorio — todo abierto, sin lock-in."
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {openSourceProjects.map((project, i) => (
          <Reveal delay={(i % 3) * 80}>
            <a
              href={`https://github.com/${project.repo}`}
              target="_blank"
              rel="noopener noreferrer"
              class="card-glow group flex items-center gap-3 p-5"
            >
              <svg class="w-5 h-5 text-[#52525b] group-hover:text-[#22d3ee] transition-colors shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              <span class="font-display font-medium text-[#f4f4f5] group-hover:text-[#22d3ee] transition-colors">{project.title}</span>
              <span class="ml-auto font-mono text-[11px] text-[#52525b] hidden lg:block">{project.repo.split('/')[1]}</span>
            </a>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ RESEARCH / THESIS ============ -->
  <section id="research" class="py-24 px-4 sm:px-6 lg:px-8 scroll-mt-16">
    <div class="max-w-7xl mx-auto">
      <SectionHeading
        index="003"
        title="La Tesis"
        subtitle="La IA debe correr en tu hardware. Soberanía total sobre tus datos, memoria y agentes."
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          {
            icon: "⌂",
            title: "Local-first",
            text: "Modelos, memoria y agentes que operan en tu dispositivo. Sin conexión forzada, sin exfiltración de datos.",
          },
          {
            icon: "🔐",
            title: "Privacy-first",
            text: "Cifrado E2E, SSI on-device y almacenamiento que solo guarda bytes cifrados. Tú eres el dueño legítimo de tus datos.",
          },
          {
            icon: "◈",
            title: "Sovereign",
            text: "Redes P2P (mesh), tokenomics abiertas y gobernanza transparente. Sin lock-in de nube ni dependencia de terceros.",
          },
        ].map((p, i) => (
          <Reveal delay={i * 100}>
            <div class="card-glow p-8 h-full">
              <div class="w-12 h-12 rounded-lg border border-[#22d3ee]/25 bg-[#22d3ee]/10 flex items-center justify-center text-xl text-[#22d3ee] mb-6">
                {p.icon}
              </div>
              <h3 class="font-display text-xl font-semibold text-[#f4f4f5] mb-3">{p.title}</h3>
              <p class="text-[#a1a1aa] leading-relaxed text-sm">{p.text}</p>
            </div>
          </Reveal>
        ))}
      </div>

      <Reveal delay={150}>
        <blockquote class="mt-16 max-w-3xl mx-auto text-center">
          <p class="font-display text-2xl sm:text-3xl font-medium text-[#f4f4f5] leading-snug">
            "La premisa principal es la comodidad de todos los seres humanos en la Tierra,
            brindando tecnología segura, abierta e inteligente."
          </p>
          <cite class="block mt-6 font-mono text-sm not-italic text-[#52525b]">— Brahyan Belalcazar, Founder & CEO</cite>
        </blockquote>
      </Reveal>
    </div>
  </section>

  <!-- ============ ABOUT ============ -->
  <section id="about" class="py-24 px-4 sm:px-6 lg:px-8 bg-[#0c0c0e] border-y border-white/[0.06] scroll-mt-16">
    <div class="max-w-3xl mx-auto text-center">
      <SectionHeading
        index="004"
        title="Sobre Nosotros"
        subtitle="SouthWest AI Labs (SWAL) construye la infraestructura abierta de la IA soberana: memoria agentic, redes P2P y runtimes de agentes."
      />

      <Reveal>
        <div class="card-glow p-8 mb-10 text-left">
          <div class="flex items-center gap-5 mb-6">
            <div class="w-16 h-16 rounded-xl border border-[#22d3ee]/30 bg-[#22d3ee]/10 flex items-center justify-center shrink-0">
              <span class="font-display text-xl font-bold text-[#22d3ee]">BB</span>
            </div>
            <div>
              <h3 class="font-display text-2xl font-semibold text-[#f4f4f5]">Brahyan Belalcazar</h3>
              <p class="font-mono text-sm text-[#22d3ee]">Founder & CEO · SouthWest AI Labs</p>
            </div>
          </div>
          <p class="text-[#a1a1aa] leading-relaxed">
            <strong class="text-[#f4f4f5] font-medium">SouthWest AI Labs (SWAL)</strong> construye la infraestructura abierta para que la IA
            corra en tu dispositivo: memoria agentic, redes P2P y runtimes de agentes — todo open source,
            sin lock-in de nube y con soberanía total sobre tus datos.
          </p>
        </div>
      </Reveal>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <Stat value="16+" label="Projects" />
        <Stat value="20+" label="Open Source Repos" delay={100} />
        <Stat value="8+" label="Technologies" delay={200} />
      </div>
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section id="contact" class="py-24 px-4 sm:px-6 lg:px-8 scroll-mt-16">
    <div class="max-w-3xl mx-auto text-center">
      <SectionHeading
        index="005"
        title="Contact"
        subtitle="¿Colaboramos? Abierto a research partnerships, ofertas y contribuciones."
      />

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <Reveal>
          <a href="https://github.com/iberi22" target="_blank" rel="noopener noreferrer" class="card-glow group p-8 flex flex-col items-center">
            <svg class="w-8 h-8 text-[#a1a1aa] group-hover:text-[#22d3ee] mb-4 transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            <h3 class="font-display font-semibold text-[#f4f4f5] mb-1 group-hover:text-[#22d3ee] transition-colors">GitHub</h3>
            <p class="font-mono text-xs text-[#71717a]">@iberi22</p>
          </a>
        </Reveal>

        <Reveal delay={100}>
          <a href="https://t.me/BeRi0n3" target="_blank" rel="noopener noreferrer" class="card-glow group p-8 flex flex-col items-center">
            <svg class="w-8 h-8 text-[#a1a1aa] group-hover:text-[#22d3ee] mb-4 transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
            <h3 class="font-display font-semibold text-[#f4f4f5] mb-1 group-hover:text-[#22d3ee] transition-colors">Telegram</h3>
            <p class="font-mono text-xs text-[#71717a]">@BeRi0n3</p>
          </a>
        </Reveal>

        <Reveal delay={200}>
          <a href="https://github.com/southwest-ai-labs" target="_blank" rel="noopener noreferrer" class="card-glow group p-8 flex flex-col items-center">
            <svg class="w-8 h-8 text-[#a1a1aa] group-hover:text-[#22d3ee] mb-4 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
            </svg>
            <h3 class="font-display font-semibold text-[#f4f4f5] mb-1 group-hover:text-[#22d3ee] transition-colors">Website</h3>
            <p class="font-mono text-xs text-[#71717a]">southwest-ai-labs</p>
          </a>
        </Reveal>
      </div>
    </div>
  </section>
</Layout>
