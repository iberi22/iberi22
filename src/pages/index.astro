---
import Layout from '../layouts/Layout.astro';
import ShaderBackground from '../components/ShaderBackground.astro';
import Reveal from '../components/Reveal.astro';
import '../styles/global.css';

const ecosystemApps = [
  {
    id: "APP_01",
    title: "SaberParaTodos",
    url: "https://saberparatodos.space",
    tag: "Educational RAG interface",
    tech: "Astro, Svelte, TailwindCSS, Supabase",
  },
  {
    id: "APP_02",
    title: "Shelf",
    url: "https://shelf-inventory.vercel.app",
    tag: "P2P inventory & POS",
    tech: "React 19, TypeScript, P2P (CRDT)",
  },
  {
    id: "APP_03",
    title: "Hosteler-IA",
    url: "https://hosteler-ia-mu.vercel.app",
    tag: "Field service agent",
    tech: "TypeScript, React, IA",
  },
  {
    id: "APP_04",
    title: "MiMatera",
    url: "https://mimatera-catalogador.pages.dev",
    tag: "Agricultural catalog PWA",
    tech: "PWA, JavaScript",
  },
  {
    id: "APP_05",
    title: "TikTokBoost",
    url: "https://tiktboost.vercel.app",
    tag: "Content analytics engine",
    tech: "TypeScript",
  },
  {
    id: "APP_06",
    title: "OrionHealth",
    url: "https://github.com/iberi22/OrionHealth",
    tag: "Medical diagnostic copilot",
    tech: "Flutter, Dart",
  },
];

const infraProjects = [
  { name: "Gestalt", desc: "Core Orchestrator", url: "https://github.com/iberi22/gestalt", accent: false },
  { name: "Xavier", desc: "Memoria Agentic", url: "https://github.com/iberi22/xavier", accent: true },
  { name: "Obscura", desc: "Privacy Layer", url: "https://github.com/iberi22/obscura", accent: false },
  { name: "swal-ui", desc: "Component Library", url: "https://github.com/iberi22/swal-ui", accent: false },
  { name: "SWAL Desktop", desc: "Desktop GUI App", url: "https://github.com/iberi22/swal-desktop", accent: false },
  { name: "GOS", desc: "Open Culinary Standard", url: "https://github.com/iberi22/gastronomic-open-standard-GOS", accent: false },
  { name: "Isar Agent Memory", desc: "Vector Storage", url: "https://github.com/iberi22/isar_agent_memory", accent: false },
  { name: "MCP Database Server", desc: "Context Protocol DB", url: "https://github.com/iberi22/mcp-database-server", accent: false },
  { name: "Socrata-rs", desc: "Rust Data Lib", url: "https://github.com/iberi22/socrata-rs", accent: false },
  { name: "SWAL Agent Rust", desc: "Rust Agent Runtime", url: "https://github.com/iberi22/swal-agent-rust", accent: false },
  { name: "WebAuditMCP", desc: "Web Auditing for Agents", url: "https://github.com/iberi22/WebAuditMCP", accent: false },
  { name: "Skills", desc: "Agent Skills Registry", url: "https://github.com/iberi22/skills", accent: false },
];
---

<Layout>
  <ShaderBackground />

  <!-- ============ HERO ============ -->
  <section class="min-h-[80vh] flex flex-col justify-center max-w-4xl pt-20 mb-32">
    <Reveal>
      <div class="font-mono-label text-mono-label text-[#22d3ee] mb-6 flex items-center gap-2">
        <span class="material-symbols-outlined text-sm">terminal</span>
        <span>SYS.INIT // v2.0.4</span>
      </div>
    </Reveal>
    <Reveal delay={80}>
      <h1 class="massive-heading mb-8">
        SouthWest<br />AI Labs
      </h1>
    </Reveal>
    <Reveal delay={160}>
      <p class="font-body-lg text-body-lg text-[#859397] max-w-2xl leading-relaxed border-l-2 border-[#3c494c]/50 pl-6">
        IA local, privada y soberana. La inteligencia debe correr en tu hardware, no en el data center de otros.
        Construimos infraestructura de investigación para arquitecturas descentralizadas.
      </p>
    </Reveal>
    <Reveal delay={240}>
      <div class="mt-12 flex flex-wrap gap-4">
        <a
          href="https://github.com/iberi22/swal-desktop"
          target="_blank"
          rel="noopener noreferrer"
          class="border border-[#3c494c]/30 text-[#e5e2e3] px-8 py-3 font-mono-label text-mono-label hover:bg-[#131314] transition-colors flex items-center gap-2 rounded"
        >
          <span class="material-symbols-outlined text-[18px]">download</span>
          Get SWAL Desktop
        </a>
        <a
          href="#research"
          class="text-[#22d3ee] px-8 py-3 font-mono-label text-mono-label hover:underline decoration-[#22d3ee] transition-all flex items-center gap-2"
        >
          Read Manifesto
          <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </a>
      </div>
    </Reveal>
  </section>

  <!-- ============ CORE TENETS ============ -->
  <section class="mb-40" id="research">
    <Reveal>
      <div class="section-head">
        <span class="material-symbols-outlined text-[#22d3ee]">architecture</span>
        <h2 class="font-headline-lg text-headline-lg text-[#f4f4f5]">Core Tenets</h2>
      </div>
    </Reveal>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {[
        {
          icon: "dns",
          title: "Local-first",
          text: "Ejecución en el edge. Modelos optimizados para inferencia en hardware de consumo. Latencia ultra baja sin dependencia de red externa.",
        },
        {
          icon: "shield_lock",
          title: "Privacy-first",
          text: "Tus datos, tus pesos. Arquitecturas que garantizan aislamiento criptográfico de contextos y memorias agenticas (Xavier).",
        },
        {
          icon: "hub",
          title: "Decentralized",
          text: "Protocolos P2P para sincronización de estados agenticos y distribución de cargas cognitivas a través del edge-mesh.",
        },
      ].map((p, i) => (
        <Reveal delay={i * 100}>
          <div class="p-8 border border-[#3c494c]/20 bg-[#131314] card-hover rounded">
            <div class="w-12 h-12 bg-[#0a0a0b] flex items-center justify-center border border-[#3c494c]/30 mb-6 rounded">
              <span class="material-symbols-outlined text-[#e5e2e3]">{p.icon}</span>
            </div>
            <h3 class="font-headline-md text-headline-md text-[#f4f4f5] mb-4">{p.title}</h3>
            <p class="font-body-md text-body-md text-[#859397]">{p.text}</p>
          </div>
        </Reveal>
      ))}
    </div>
  </section>

  <!-- ============ ECOSYSTEM APPLICATIONS ============ -->
  <section class="mb-40" id="ecosystem">
    <Reveal>
      <div class="section-head">
        <span class="material-symbols-outlined text-[#22d3ee]">apps</span>
        <h2 class="font-headline-lg text-headline-lg text-[#f4f4f5]">Ecosystem Applications</h2>
      </div>
    </Reveal>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {ecosystemApps.map((app, i) => (
        <Reveal delay={(i % 3) * 100}>
          <a
            href={app.url}
            target="_blank"
            rel="noopener noreferrer"
            class="glass-panel p-6 flex flex-col justify-between h-48 card-hover rounded block"
          >
            <div>
              <div class="font-mono-label text-mono-label text-[#22d3ee] mb-2">{app.id}</div>
              <h4 class="font-headline-md text-headline-md text-[#e5e2e3] mb-2">{app.title}</h4>
              <div class="font-mono-code text-mono-code text-[#3c494c] text-sm">{app.tag}</div>
            </div>
            <div class="flex flex-wrap gap-2 mt-4">
              {app.tech.split(', ').map((t) => (
                <span class="font-mono-code text-mono-code text-[11px] px-2 py-0.5 rounded border border-[#3c494c]/30 bg-[#0a0a0b] text-[#859397]">
                  {t}
                </span>
              ))}
            </div>
          </a>
        </Reveal>
      ))}
    </div>
  </section>

  <!-- ============ OPEN SOURCE / INFRASTRUCTURE ============ -->
  <section class="mb-32" id="github">
    <Reveal>
      <div class="flex items-center justify-between mb-16 border-b border-[#3c494c]/20 pb-4">
        <div class="flex items-center gap-4">
          <span class="material-symbols-outlined text-[#22d3ee]">code_blocks</span>
          <h2 class="font-headline-lg text-headline-lg text-[#f4f4f5]">Open Source Infrastructure</h2>
        </div>
        <a class="text-[#e5e2e3] hover:text-[#22d3ee] transition-colors hidden md:block font-mono-label text-mono-label" href="https://github.com/iberi22" target="_blank" rel="noopener noreferrer">
          View on GitHub →
        </a>
      </div>
    </Reveal>
    <Reveal delay={100}>
      <div class="border border-[#3c494c]/20 bg-[#131314] p-8 rounded">
        <p class="font-mono-code text-mono-code text-[#859397] mb-8 leading-relaxed">
          /* Core infrastructure projects enabling local AI capabilities.
             Stack utilizes Rust for performance-critical agent logic and memory management. */
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-y-8 gap-x-6">
          {infraProjects.map((p) => (
            <a
              href={p.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`border-l pl-4 ${p.accent ? 'border-[#22d3ee]/50' : 'border-[#3c494c]/30'} hover:border-[#22d3ee] transition-colors group`}
            >
              <div class={`font-body-md text-body-md font-medium mb-1 group-hover:text-[#22d3ee] transition-colors ${p.accent ? 'text-[#22d3ee]' : 'text-[#f4f4f5]'}`}>
                {p.name}
              </div>
              <div class="font-mono-label text-mono-label text-[#859397] text-[11px]">{p.desc}</div>
            </a>
          ))}
        </div>
        <div class="mt-12 pt-8 border-t border-[#3c494c]/20">
          <div class="font-mono-label text-mono-label text-[#859397] mb-4">Infrastructure Dependencies:</div>
          <div class="flex flex-wrap gap-4 font-mono-code text-mono-code text-sm">
            {["edge-mesh", "Maloca", "gara-g", "Xavier", "swal-ui"].map((d) => (
              <span class="bg-[#0a0a0b] px-3 py-1 border border-[#3c494c]/30 rounded text-[#e5e2e3]">{d}</span>
            ))}
          </div>
        </div>
      </div>
    </Reveal>
  </section>
</Layout>
