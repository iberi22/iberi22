---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Brahyan Belalcazar — Software Engineer & AI Builder",
  description = "Full-stack developer & AI engineer. Fundador de SouthWest AI Labs (SWAL). Rust, Flutter, TypeScript, sistemas distribuidos.",
} = Astro.props;
---

<!doctype html>
<html class="dark" lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://iberi22.github.io/iberi22/" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-[#0a0a0b] text-[#cfccc7] selection:bg-[#22d3ee] selection:text-[#00363e]">
    <!-- TopNavBar (Stitch) -->
    <nav class="fixed top-0 w-full z-50 bg-[#131314]/80 backdrop-blur-md flex justify-between items-center px-4 md:px-16 h-20 border-b border-[#3c494c]/30">
      <div class="max-w-[1440px] mx-auto flex w-full justify-between items-center">
        <a href="#top" class="font-headline-md font-bold tracking-tighter text-[#d8d5d0] hover:text-[#22d3ee] transition-colors">BELA</a>
        <div class="hidden md:flex space-x-8 items-center">
          <a class="text-[#22d3ee] font-medium border-b border-[#22d3ee] pb-1 opacity-80 transition-all font-body-md text-body-md" href="#top">Inicio</a>
          <a class="text-[#a8a5a1] font-medium pb-1 hover:text-[#22d3ee] transition-colors duration-200 font-body-md text-body-md" href="#stack">Stack</a>
          <a class="text-[#a8a5a1] font-medium pb-1 hover:text-[#22d3ee] transition-colors duration-200 font-body-md text-body-md" href="#projects">Proyectos</a>
          <a class="text-[#a8a5a1] font-medium pb-1 hover:text-[#22d3ee] transition-colors duration-200 font-body-md text-body-md" href="#about">Sobre</a>
        </div>
        <a
          href="https://t.me/BeRi0n3"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-[#22d3ee] text-[#005763] px-6 py-2 rounded font-mono-label text-mono-label hover:bg-[#a2eeff] transition-colors"
        >
          Contacto
        </a>
      </div>
    </nav>

    <!-- Main Content Canvas -->
    <main id="top" class="relative pt-32 pb-16 px-4 md:px-16 max-w-[1440px] mx-auto">
      <slot />
    </main>

    <!-- Footer (Stitch) -->
    <footer class="w-full py-16 px-4 md:px-16 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-[1440px] mx-auto border-t border-[#3c494c]/20 bg-[#0e0e0f] text-[#7e8b8f]">
      <div class="flex flex-col justify-between">
        <div class="font-mono-label text-mono-label font-bold text-[#d8d5d0] mb-8">BELA</div>
        <div class="font-mono-label text-mono-label leading-relaxed">
          © 2026 Brahyan Belalcazar.<br />
          Full-stack &amp; AI engineer · @iberi22<br />
          All rights reserved · AGPL-3.0
        </div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-8">
        <div class="flex flex-col space-y-4">
          <div class="font-mono-label text-mono-label text-[#d8d5d0] mb-2">Proyectos</div>
          <span class="font-body-md text-body-md text-[#7e8b8f]">Xavier · apertura próximamente</span>
          <a class="font-body-md text-body-md hover:text-[#8aebff] transition-colors hover:underline decoration-[#8aebff] decoration-2" href="https://github.com/iberi22/gestalt" target="_blank" rel="noopener noreferrer">Gestalt</a>
          <a class="font-body-md text-body-md hover:text-[#8aebff] transition-colors hover:underline decoration-[#8aebff] decoration-2" href="https://github.com/iberi22/swal-ui" target="_blank" rel="noopener noreferrer">swal-ui</a>
        </div>
        <div class="flex flex-col space-y-4">
          <div class="font-mono-label text-mono-label text-[#d8d5d0] mb-2">Lab</div>
          <a class="font-body-md text-body-md hover:text-[#8aebff] transition-colors hover:underline decoration-[#8aebff] decoration-2" href="https://southwest-ai-labs.github.io" target="_blank" rel="noopener noreferrer">southwest-ai-labs.github.io</a>
          <a class="font-body-md text-body-md hover:text-[#8aebff] transition-colors hover:underline decoration-[#8aebff] decoration-2" href="https://github.com/southwest-ai-labs" target="_blank" rel="noopener noreferrer">Organization</a>
        </div>
        <div class="flex flex-col space-y-4">
          <div class="font-mono-label text-mono-label text-[#d8d5d0] mb-2">Social</div>
          <a class="font-body-md text-body-md hover:text-[#8aebff] transition-colors hover:underline decoration-[#8aebff] decoration-2" href="https://www.linkedin.com/in/brahyansbr" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a class="font-body-md text-body-md hover:text-[#8aebff] transition-colors hover:underline decoration-[#8aebff] decoration-2" href="https://github.com/iberi22" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a class="font-body-md text-body-md hover:text-[#8aebff] transition-colors hover:underline decoration-[#8aebff] decoration-2" href="https://t.me/BeRi0n3" target="_blank" rel="noopener noreferrer">Telegram</a>
        </div>
      </div>
    </footer>
  </body>
</html>
