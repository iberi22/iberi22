---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "SouthWest AI Labs | IA Local y Soberana",
  description = "IA local, privada y soberana. La inteligencia debe correr en tu hardware, no en el data center de otros. Laboratorio de investigación open-source.",
} = Astro.props;
---

<!doctype html>
<html class="dark" lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://iberi22.github.io/iberi22/" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-[#0a0a0b] text-[#e5e2e3] selection:bg-[#22d3ee] selection:text-[#00363e]">
    <!-- TopNavBar (Stitch) -->
    <nav class="fixed top-0 w-full z-50 bg-[#131314]/80 backdrop-blur-md flex justify-between items-center px-4 md:px-16 h-20 border-b border-[#3c494c]/30">
      <div class="max-w-[1440px] mx-auto flex w-full justify-between items-center">
        <a href="#top" class="font-headline-md font-bold tracking-tighter text-[#e5e2e3] hover:text-[#22d3ee] transition-colors">SWAL</a>
        <div class="hidden md:flex space-x-8 items-center">
          <a class="text-[#22d3ee] font-medium border-b border-[#22d3ee] pb-1 opacity-80 transition-all font-body-md text-body-md" href="#top">Lab</a>
          <a class="text-[#bbc9cd] font-medium pb-1 hover:text-[#22d3ee] transition-colors duration-200 font-body-md text-body-md" href="#research">Research</a>
          <a class="text-[#bbc9cd] font-medium pb-1 hover:text-[#22d3ee] transition-colors duration-200 font-body-md text-body-md" href="#ecosystem">Ecosystem</a>
          <a class="text-[#bbc9cd] font-medium pb-1 hover:text-[#22d3ee] transition-colors duration-200 font-body-md text-body-md" href="#github">GitHub</a>
        </div>
        <a
          href="https://t.me/BeRi0n3"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-[#22d3ee] text-[#005763] px-6 py-2 rounded font-mono-label text-mono-label hover:bg-[#a2eeff] transition-colors"
        >
          Connect
        </a>
      </div>
    </nav>

    <!-- Main Content Canvas -->
    <main id="top" class="relative pt-32 pb-16 px-4 md:px-16 max-w-[1440px] mx-auto">
      <slot />
    </main>

    <!-- Footer (Stitch) -->
    <footer class="w-full py-16 px-4 md:px-16 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-[1440px] mx-auto border-t border-[#3c494c]/20 bg-[#0e0e0f] text-[#859397]">
      <div class="flex flex-col justify-between">
        <div class="font-mono-label text-mono-label font-bold text-[#e5e2e3] mb-8">SWAL</div>
        <div class="font-mono-label text-mono-label leading-relaxed">
          © 2026 SouthWest AI Labs.<br />
          Founder &amp; CEO Brahyan Belalcazar (@iberi22).<br />
          All rights reserved · AGPL-3.0
        </div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-8">
        <div class="flex flex-col space-y-4">
          <div class="font-mono-label text-mono-label text-[#e5e2e3] mb-2">Projects</div>
          <a class="font-body-md text-body-md hover:text-[#8aebff] transition-colors hover:underline decoration-[#8aebff] decoration-2" href="https://github.com/iberi22/gestalt" target="_blank" rel="noopener noreferrer">Gestalt</a>
          <a class="font-body-md text-body-md hover:text-[#8aebff] transition-colors hover:underline decoration-[#8aebff] decoration-2" href="https://github.com/iberi22/xavier" target="_blank" rel="noopener noreferrer">Xavier</a>
          <a class="font-body-md text-body-md hover:text-[#8aebff] transition-colors hover:underline decoration-[#8aebff] decoration-2" href="https://github.com/iberi22/obscura" target="_blank" rel="noopener noreferrer">Obscura</a>
        </div>
        <div class="flex flex-col space-y-4">
          <div class="font-mono-label text-mono-label text-[#e5e2e3] mb-2">Infra</div>
          <a class="font-body-md text-body-md hover:text-[#8aebff] transition-colors hover:underline decoration-[#8aebff] decoration-2" href="https://github.com/iberi22/edge-mesh" target="_blank" rel="noopener noreferrer">edge-mesh</a>
          <a class="font-body-md text-body-md hover:text-[#8aebff] transition-colors hover:underline decoration-[#8aebff] decoration-2" href="https://github.com/iberi22/maloca" target="_blank" rel="noopener noreferrer">Maloca</a>
          <a class="font-body-md text-body-md hover:text-[#8aebff] transition-colors hover:underline decoration-[#8aebff] decoration-2" href="https://github.com/iberi22/gara-g" target="_blank" rel="noopener noreferrer">gara-g</a>
        </div>
        <div class="flex flex-col space-y-4">
          <div class="font-mono-label text-mono-label text-[#e5e2e3] mb-2">Legal</div>
          <a class="font-body-md text-body-md hover:text-[#8aebff] transition-colors hover:underline decoration-[#8aebff] decoration-2" href="https://github.com/iberi22/iberi22/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">License</a>
          <a class="font-body-md text-body-md hover:text-[#8aebff] transition-colors hover:underline decoration-[#8aebff] decoration-2" href="https://github.com/southwest-ai-labs" target="_blank" rel="noopener noreferrer">Organization</a>
        </div>
      </div>
    </footer>
  </body>
</html>
