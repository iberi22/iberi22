---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "SouthWest AI Labs — Local-first, privacy-first AI",
  description = "Laboratorio open-source de IA. Construimos agentes con memoria infinita que corren en tu hardware: memoria agentic, redes P2P y runtimes soberanos.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://iberi22.github.io/iberi22/" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" as="style" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Navigation -->
    <nav class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md border-b border-white/[0.06] bg-[#0a0a0b]/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <a href="#top" class="flex items-center gap-3 group">
            <!-- SWAL mark: hexagon lab node -->
            <svg class="w-8 h-8" viewBox="0 0 32 32" fill="none" aria-hidden="true">
              <rect x="2" y="2" width="28" height="28" rx="8" stroke="#22d3ee" stroke-width="1.5" />
              <circle cx="16" cy="16" r="3.5" fill="#22d3ee" />
              <circle cx="10" cy="11" r="1.5" fill="#22d3ee" opacity="0.6" />
              <circle cx="22" cy="20" r="1.5" fill="#22d3ee" opacity="0.6" />
              <path d="M13.5 14.5L10.5 11.5M18 18l4 2" stroke="#22d3ee" stroke-width="1" opacity="0.6" />
            </svg>
            <span class="font-display font-semibold text-lg text-[#f4f4f5] tracking-tight group-hover:text-[#22d3ee] transition-colors">
              SouthWest AI Labs
            </span>
          </a>
          <div class="hidden md:flex items-center gap-8">
            <a href="#projects" class="nav-link">Proyectos</a>
            <a href="#open-source" class="nav-link">Open Source</a>
            <a href="#research" class="nav-link">Research</a>
            <a href="#about" class="nav-link">Sobre</a>
          </div>
          <a
            href="https://github.com/iberi22"
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 border border-white/[0.08] bg-[#161618] hover:border-[#22d3ee]/40 hover:text-[#22d3ee]"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            GitHub
          </a>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <main id="top" class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-white/[0.06] mt-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6">
          <div class="flex items-center gap-3">
            <svg class="w-7 h-7" viewBox="0 0 32 32" fill="none" aria-hidden="true">
              <rect x="2" y="2" width="28" height="28" rx="8" stroke="#22d3ee" stroke-width="1.5" />
              <circle cx="16" cy="16" r="3.5" fill="#22d3ee" />
            </svg>
            <span class="font-display font-semibold text-white">SouthWest AI Labs</span>
          </div>
          <div class="flex items-center gap-6">
            <a href="https://github.com/iberi22" target="_blank" rel="noopener noreferrer" class="text-[#a1a1aa] hover:text-[#f4f4f5] transition-colors flex items-center gap-2 text-sm">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              GitHub
            </a>
            <a href="https://t.me/BeRi0n3" target="_blank" rel="noopener noreferrer" class="text-[#a1a1aa] hover:text-[#f4f4f5] transition-colors flex items-center gap-2 text-sm">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
              Telegram
            </a>
            <a href="https://github.com/southwest-ai-labs" target="_blank" rel="noopener noreferrer" class="text-[#a1a1aa] hover:text-[#f4f4f5] transition-colors flex items-center gap-2 text-sm">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
              Website
            </a>
          </div>
        </div>
        <div class="mt-8 pt-8 border-t border-white/[0.06] flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
          <div class="font-mono text-xs text-[#52525b]">© 2026 SouthWest AI Labs · AGPL-3.0</div>
          <div class="font-mono text-xs text-[#52525b]">Local-first · Privacy-first · Sovereign</div>
        </div>
      </div>
    </footer>
  </body>
</html>
